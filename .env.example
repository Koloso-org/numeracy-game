# Copy this file to ".env" and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Do NOT commit the real .env.
#
# The anon key is safe to ship in a mobile app — the database is protected by
# Row Level Security. Never put the service_role key here.

EXPO_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-public-key-here
